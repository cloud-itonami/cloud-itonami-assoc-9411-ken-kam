(defn entry-field [a :string i :i64 f :string] [:option :string]
  (if (valid-entry? a i)
    (cond
      (= i 0) (entry-field-0 f)
      (= i 1) (entry-field-1 f)
      (= i 2) (entry-field-2 f)
      (= i 3) (entry-field-3 f)
      (= i 4) (entry-field-4 f)
      (= i 5) (entry-field-5 f)
      (= i 6) (entry-field-6 f)
      (= i 7) (entry-field-7 f)
      (= i 8) (entry-field-8 f)
      (= i 9) (entry-field-9 f)
      (= i 10) (entry-field-10 f)
      (= i 11) (entry-field-11 f)
      (= i 12) (entry-field-12 f)
      (= i 13) (entry-field-13 f)
      (= i 14) (entry-field-14 f)
      :else (option-none-of [:option :string]))
    (option-none-of [:option :string])))

(defn topic-count [a :string i :i64] :i64
  (if (valid-entry? a i)
    (cond
      (= i 0) 2
      (= i 1) 1
      (= i 2) 2
      (= i 3) 1
      (= i 4) 2
      (= i 5) 1
      (= i 6) 2
      (= i 7) 2
      (= i 8) 2
      (= i 9) 2
      (= i 10) 1
      (= i 11) 1
      (= i 12) 1
      (= i 13) 2
      (= i 14) 1
      :else 0)
    0))

(defn topic [a :string i :i64 t :i64] [:option :string]
  (if (valid-entry? a i)
    (cond
      (= i 0) (cond
        (= t 0) (option-some-of [:option :string] "governance")

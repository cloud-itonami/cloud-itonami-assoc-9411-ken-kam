(defn by-topic-count [a :string candidate :string] :i64
  (if (association-covered? a)
    (cond
      (string=? candidate "energy") 1
      (string=? candidate "environment") 1
      (string=? candidate "finance") 1
      (string=? candidate "governance") 6
      (string=? candidate "history") 2
      (string=? candidate "inclusion") 1
      (string=? candidate "membership") 4
      (string=? candidate "policy") 2
      (string=? candidate "regional") 1
      (string=? candidate "regulatory") 1
      (string=? candidate "training") 3
      :else 0)
    0))

(defn by-topic-id [a :string candidate :string i :i64] [:option :string]
  (if (association-covered? a)
    (cond
      (string=? candidate "energy") (cond
        (= i 0) (entry-field a 9 "id")
        :else (option-none-of [:option :string]))
      (string=? candidate "environment") (cond
        (= i 0) (entry-field a 10 "id")
        :else (option-none-of [:option :string]))
      (string=? candidate "finance") (cond
        (= i 0) (entry-field a 8 "id")
        :else (option-none-of [:option :string]))
      (string=? candidate "governance") (cond
        (= i 0) (entry-field a 0 "id")
        (= i 1) (entry-field a 2 "id")
        (= i 2) (entry-field a 3 "id")
        (= i 3) (entry-field a 4 "id")
        (= i 4) (entry-field a 5 "id")
        (= i 5) (entry-field a 7 "id")
        :else (option-none-of [:option :string]))
      (string=? candidate "history") (cond
        (= i 0) (entry-field a 0 "id")
        (= i 1) (entry-field a 1 "id")
        :else (option-none-of [:option :string]))
      (string=? candidate "inclusion") (cond
        (= i 0) (entry-field a 11 "id")
        :else (option-none-of [:option :string]))
      (string=? candidate "membership") (cond
        (= i 0) (entry-field a 4 "id")
        (= i 1) (entry-field a 6 "id")
        (= i 2) (entry-field a 7 "id")
        (= i 3) (entry-field a 8 "id")
        :else (option-none-of [:option :string]))
      (string=? candidate "policy") (cond
        (= i 0) (entry-field a 2 "id")
        (= i 1) (entry-field a 9 "id")
        :else (option-none-of [:option :string]))
      (string=? candidate "regional") (cond
        (= i 0) (entry-field a 6 "id")
        :else (option-none-of [:option :string]))
      (string=? candidate "regulatory") (cond
        (= i 0) (entry-field a 13 "id")
        :else (option-none-of [:option :string]))
      (string=? candidate "training") (cond
        (= i 0) (entry-field a 12 "id")
        (= i 1) (entry-field a 13 "id")
        (= i 2) (entry-field a 14 "id")
        :else (option-none-of [:option :string]))
      :else (option-none-of [:option :string]))
    (option-none-of [:option :string])))

(defn coverage-note [a :string] [:option :string]
  (if (association-covered? a)
    (option-some-of [:option :string] 
      "cloud-itonami-assoc-9411-ken-kam Wave 0 (ADR-2607141700): 15 KAM entries, each citing a source with the page and the verbatim span it rests on. All but one are kam.co.ke pages; the one exception is a Manufacturing Outlook interview with KAM's Chairman, kept as independent corroboration of the founding year. Extend data/datascript-tx.edn and regenerate; never fabricate an id/url.")
    (option-none-of [:option :string])))

